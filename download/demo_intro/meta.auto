[cozy_engine:unified]        = UnifiedToolbox (Color + Cozy in one dispatch)
[cozy_engine:start]          = cozy_engine/start.py (singleton cache: reader/store/matrix/toolbox)
[cozy_engine:rollback]       = !remove cozy-engine (disable + preserve in legacy/)
