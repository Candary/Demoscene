{
  "version": "1.0",
  "paths": {
    "base": "..",
    "output": "out",
    "cache": ".nxgen_cache",
    "plugins": [],
    "report": "report.json"
  },
  "intent": {
    "default_mood": "calm",
    "seed": 7
  },
  "keywords": {
    "mood": {
      "calm": [
        "calm",
        "quiet",
        "cozy",
        "soft",
        "спокойный",
        "тихий",
